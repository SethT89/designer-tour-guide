# ---- committed in .env (public-safe) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_MAP_CENTER_LNG=-96.7970
NEXT_PUBLIC_MAP_CENTER_LAT=32.7767
NEXT_PUBLIC_MAP_ZOOM=11
NEXT_PUBLIC_DEFAULT_CITY=Dallas
# Base URL for magic-link redirects. .env carries the prod URL; .env.local
# overrides to http://localhost:3000 for dev.
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.workers.dev

# ---- .env.local only (gitignored, SECRET-ish) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The one email address allowed into the /admin dashboard. Not secret, but not
# NEXT_PUBLIC either — it is read server-side (middleware + server actions).
ADMIN_EMAIL=you@example.com
